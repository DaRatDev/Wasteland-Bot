# Copy this file to .env and fill in your values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot tab > Reset Token)
DISCORD_TOKEN=

# Right-click your server > Copy Server ID (needs Developer Mode on)
GUILD_ID=

# Right-click #general > Copy Channel ID
ANNOUNCE_CHANNEL_ID=

# Optional: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
